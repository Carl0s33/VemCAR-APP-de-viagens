# --- DEPENDÊNCIAS (A regra de ouro) ---
# Nunca suba a node_modules, ela é pesada e o npm install reconstrói tudo.
node_modules/
jspm_packages/

# --- AMBIENTE E SEGURANÇA ---
# Arquivos com chaves de API do Google, Azure ou Firebase nunca devem subir!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- CACHE E LOGS ---
# Evita erros de "spec" e arquivos de log que só servem pra ocupar espaço.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache
.vite/
.parcel-cache

# --- BUILD (PRODUÇÃO) ---
# A pasta final que vai pro servidor não precisa estar no código fonte.
dist/
dist-ssr/
*.local

# --- SISTEMA OPERACIONAL ---
# O Windows e o Mac criam arquivos inúteis nas pastas.
.DS_Store
Thumbs.db
Desktop.ini

# --- VS CODE ---
# Suas configurações pessoais do editor não precisam ir pros outros.
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj