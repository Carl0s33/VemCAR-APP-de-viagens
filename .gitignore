# --- AMBIENTE E SEGURANÇA ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- CACHE E LOGS ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache
.vite/
.parcel-cache

# --- BUILD (PRODUÇÃO) ---
dist/
dist-ssr/
*.local

